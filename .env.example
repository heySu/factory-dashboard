# ============================================================
# 前端数据接入配置
# ============================================================

# 数据接入模式：auto | http | mock
#   auto  先请求后端 REST + WebSocket，失败自动降级为本地模拟数据（推荐）
#   http  强制走后端，失败即报错（生产环境用，便于暴露问题）
#   mock  强制本地模拟，不需要启动后端
VITE_DATA_MODE=auto

# 接口前缀。开发期由 Vite 代理到 http://127.0.0.1:8080，生产由 Nginx 转发
VITE_API_BASE=/api

# WebSocket 地址。留空则自动使用「当前域名 + /ws/dashboard」
# 前端与后端不同域部署时才需要显式配置，例如：ws://10.0.0.8:8080/ws/dashboard
# VITE_WS_URL=
