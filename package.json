{
  "name": "factory-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "通用综合型智慧工厂数据可视化大屏",
  "scripts": {
    "dev": "vite --host",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"vite --host\" \"node --no-warnings server/index.js\"",
