    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.2.5",
    "puppeteer-core": "^25.16.0",
    "vite": "^5.4.8"
  }
